TEST_REMOTE=origin

# Local Syfon configured by ../../syfon/local.yaml and started separately.
TUTORIAL_SYFON_ENDPOINT=http://localhost:8080
TUTORIAL_SYFON_SCOPE=example/tutorial
TUTORIAL_SYFON_BUCKET=local-bucket
TUTORIAL_SYFON_USERNAME=drs-user
TUTORIAL_SYFON_PASSWORD=drs-pass

# Create/select the client at https://app.globus.org/settings/developers.
# Find the destination UUID at https://app.globus.org/file-manager.
GIT_DRS_GLOBUS_CLIENT_ID=00000000-0000-0000-0000-000000000000
GIT_DRS_GLOBUS_DESTINATION_COLLECTION=00000000-0000-0000-0000-000000000000

# These identify the same directory in the local filesystem and in Globus.
# WORK_ROOT must be writable and exposed by Globus Connect Personal, including
# hidden .git paths. Copy GLOBUS_DESTINATION_ROOT_PATH from File Manager.
WORK_ROOT=/absolute/path/inside/destination-collection/globus-tests
GLOBUS_DESTINATION_ROOT_PATH=/globus-tests
