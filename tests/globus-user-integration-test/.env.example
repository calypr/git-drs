# Copy to .env. Values must describe dedicated, non-production test resources.
TEST_REPO_URL=https://github.com/example/globus-integration-fixtures.git
TEST_REMOTE=research
# DRS remote created inside each standalone-publisher clone.
TEST_DRS_ENDPOINT=https://drs.example.org
TEST_DRS_PROVIDER=gen3
TEST_DRS_AUTH=bearer
TEST_DRS_SCOPE=organization/project
# Optional non-secret credential locator and publishing storage selector.
TEST_DRS_CREDENTIAL=env:GIT_DRS_TOKEN
TEST_DRS_STORAGE=
SOURCE_COLLECTION_ID=00000000-0000-0000-0000-000000000000
GIT_DRS_GLOBUS_CLIENT_ID=00000000-0000-0000-0000-000000000000
GIT_DRS_GLOBUS_DESTINATION_COLLECTION=00000000-0000-0000-0000-000000000000

# WORK_ROOT must be a direct child of the filesystem root exposed by the
# destination collection. This is the matching collection-absolute path.
WORK_ROOT=/absolute/path/inside/destination-collection/globus-tests
GLOBUS_DESTINATION_ROOT_PATH=/globus-tests

# Standalone fixture paths already committed to TEST_REPO_URL.
GLOBUS_ONLY_PATH=globus-only.bin
HTTPS_GLOBUS_PATH=https-globus.bin
HTTPS_ONLY_PATH=https-only.bin
BROKEN_GLOBUS_PATH=broken-globus.bin

# Fill these from: scripts/prepare-fixtures.sh
GLOBUS_ONLY_SHA256=
HTTPS_GLOBUS_SHA256=
HTTPS_ONLY_SHA256=
BROKEN_GLOBUS_SHA256=
RELEASE_A_SHA256=
RELEASE_B_SHA256=
RELEASE_C_SHA256=

# Writer/publisher inputs.
SOURCE_RELEASE_PATH=/release
SOURCE_STANDALONE_PATH=/standalone
# Public URL prefix serving the exact files in fixtures/standalone/.
STANDALONE_HTTPS_BASE_URL=https://data.example.org/git-drs-tests/standalone
IMPORT_DESTINATION=data/release

# Destructive operations remain off unless explicitly enabled.
ALLOW_WRITER_MUTATION=no
ALLOW_DRS_PUSH=no

